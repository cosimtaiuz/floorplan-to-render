# Copy this file to .env.local and fill in your keys. .env.local is git-ignored.

# Required: the render step always uses OpenAI, and so does the 3D scene step
# when "OpenAI" is picked in the UI.
OPENAI_API_KEY=

# Needed only to pick "Claude" as the 3D scene model in the UI.
ANTHROPIC_API_KEY=

# Both settings below are chosen in the UI, per generation. These variables are
# the ceiling a request may ask for, not the setting: leave them out and the
# whole scale is available, set one and anything above it is clamped down.

# Optional: highest reasoning effort the scene model may be asked for, for
# either provider (low | medium | high | xhigh | max). Unset: no ceiling.
# Unrecognised: medium.
# FLOORPLAN_REASONING_EFFORT=high

# Optional: highest output quality the image model may be asked for
# (low | medium | high). Unset: no ceiling. Unrecognised: medium.
# FLOORPLAN_RENDER_QUALITY=medium
